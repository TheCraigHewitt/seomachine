# OpenRouter API key — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Primary model: fast, type-safe structured JSON output. Handles every courtroom turn.
COURT_MODEL_FAST=google/gemini-2.5-flash

# Lightweight model: fallback when the primary errors/times out, and cheap turns
# (voir dire panel answers, juror chatter).
COURT_MODEL_LIGHT=meta-llama/llama-3.1-8b-instruct

# Milliseconds before the primary model is abandoned for the lightweight one.
COURT_MODEL_TIMEOUT_MS=20000
